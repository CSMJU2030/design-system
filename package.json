{
  "name": "@csmju2030/design-system",
  "version": "1.2.0",
  "description": "UI Kit และ Design Token มาตรฐานกลางของโครงการ CSMJU2030 — ใช้ร่วมกันทั้ง 37 ระบบย่อย",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CSMJU2030/design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tailwind-preset.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "csmju-ui-lint": "./dist/csmju-ui-lint.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./theme.css": "./dist/theme.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./package.json": "./package.json",
    "./components.css": "./dist/components.css"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint:self": "node tools/csmju-ui-lint.mjs --path src --allow-internal",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
