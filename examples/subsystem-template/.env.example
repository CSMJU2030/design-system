# URL ของ Core (หน้า login / logout) — ค่าสาธารณะ ใช้ได้ทั้งฝั่ง client และ server
NEXT_PUBLIC_CSMJU_CORE_URL=

# base URL ของ API ระบบย่อย (NestJS) ที่ผ่าน gateway แล้ว
NEXT_PUBLIC_API_BASE_URL=

# ---- ใช้เฉพาะฝั่ง server (route handler /auth/*) ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ ----

# origin ของระบบย่อยเอง สำหรับประกอบ redirect_uri (auth-contract §4)
# เช่น https://equipment.csmju2030.ac.th — ไม่ใส่ก็ได้ จะเดาจาก request ให้
CSMJU_APP_ORIGIN=

# client_id ที่ Core ออกให้ระบบย่อย (auth-contract §26)
CSMJU_CLIENT_ID=

# 🔴 ระบุ "ชื่อ key" เท่านั้น ห้ามใส่ค่าจริง (ci-compliance-spec §10.3 · SEC-02)
# 🔴 ห้ามใส่ความลับในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ (§16.2 ข้อ 17)
