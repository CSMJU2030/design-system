# URL ของ Core (login, dashboard, logout, refresh token)
NEXT_PUBLIC_CSMJU_CORE_URL=

# base URL ของ API ระบบย่อย (NestJS) ที่ผ่าน gateway แล้ว
NEXT_PUBLIC_API_BASE_URL=

# 🔴 ระบุ "ชื่อ key" เท่านั้น ห้ามใส่ค่าจริง (ci-compliance-spec §10.3 · SEC-02)
# 🔴 ห้ามใส่ความลับในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ (§16.2 ข้อ 17)
