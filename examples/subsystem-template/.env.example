# URL ของ Core (login, dashboard, logout, refresh token)
NEXT_PUBLIC_CSMJU_CORE_URL=https://core.csmju2030.ac.th

# base URL ของ API ระบบย่อย (NestJS) ที่ผ่าน gateway แล้ว
NEXT_PUBLIC_API_BASE_URL=https://api.csmju2030.ac.th/equipment

# 🔴 ห้ามใส่ความลับใดๆ ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ (§16.2 ข้อ 17)
#    ค่าเหล่านี้ถูกฝังลงใน JavaScript bundle และผู้ใช้ทุกคนอ่านได้
